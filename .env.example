# ============================================================================
# FocusGuard AI — 환경 변수 예시 파일 (.env.example) [통과 기준 BRB-C07 준수]
# 본 애플리케이션은 로그인 및 외부 유료 API Key 없이 100% 브라우저/로컬에서 즉시 작동합니다.
# 향후 선택적 서버/외부 알림 연동 시 아래 환경 변수 이름만 사용하며, 실제 비밀값은 소스에 넣지 않습니다.
# ============================================================================

FOCUSGUARD_ENV=production
FOCUSGUARD_DEFAULT_LATENCY_SEC=25
FOCUSGUARD_POLLING_CYCLE_SEC=12.7
FOCUSGUARD_OPTIONAL_WEBHOOK_URL=
FOCUSGUARD_OPTIONAL_API_KEY=
PORT=8080
